{
  "name": "dsh-pactflow",
  "version": "0.2.0",
  "description": "零脉 · PactFlow — installable project workflow mode for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianyuegithub/dsh-pactflow.git"
  },
  "homepage": "https://github.com/tianyuegithub/dsh-pactflow#readme",
  "bugs": {
    "url": "https://github.com/tianyuegithub/dsh-pactflow/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "pactflow",
    "multi-agent"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-pactflow-service": "bin/generate-service.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "presets/**/*",
    "README.md",
    "LICENSE",
    "bin/generate-service.mjs"
  ],
  "dependencies": {
    "@kubernetes/client-node": "2.0.0",
    "@deepseek-ai/schemastery": "3.18.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-agent-instructions": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session-query": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tool-bash": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tool-fs": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tool-fs-search": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tool-pwsh": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.1",
    "react": "^18.3.1"
  },
