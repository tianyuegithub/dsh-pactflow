{
  "name": "dsh-pactflow",
  "version": "0.1.0",
  "description": "零脉 · PactFlow — installable project workflow mode for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "presets/**/*",
    "README.md"
  ],
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session-query": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.1",
    "react": "^18.3.1"
  },
  "license": "UNLICENSED"
}
